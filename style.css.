:root {
--background: #0b1020;
--panel: #141d32;
--text: #f4f7ff;
--muted: #b7c2d8;
--accent: #63e6be;
--border: #293650;
}

* {
box-sizing: border-box;
}

html {
scroll-behavior: smooth;
}

body {
margin: 0;
background: var(--background);
color: var(--text);
font-family: Arial, sans-serif;
line-height: 1.7;
}

a {
transition: 0.2s ease;
}

.header {
display: flex;
align-items: center;
justify-content: space-between;
gap: 20px;
padding: 20px 8%;
border-bottom: 1px solid var(--border);
}

.logo {
color: var(--text);
font-size: 1.5rem;
font-weight: 800;
text-decoration: none;
}

.logo span,
.hero h1 span {
color: var(--accent);
}

nav {
display: flex;
flex-wrap: wrap;
gap: 24px;
}

nav a {
color: var(--muted);
text-decoration: none;
}

nav a:hover,
footer a:hover {
color: var(--accent);
}

.hero {
padding: 110px 8% 100px;
max-width: 1200px;
}

.eyebrow {
color: var(--accent);
font-size: 0.78rem;
font-weight: 700;
letter-spacing: 2px;
}

h1 {
margin: 22px 0;
font-size: clamp(2.5rem, 7vw, 5rem);
line-height: 1.12;
letter-spacing: -2px;
}

h2 {
font-size: clamp(1.8rem, 4vw, 2.8rem);
line-height: 1.2;
}

.intro,
.section-intro,
.about > p:not(.eyebrow),
.contact > p:not(.eyebrow),
.card p {
color: var(--muted);
}

.intro {
max-width: 650px;
font-size: 1.1rem;
}

.actions {
display: flex;
flex-wrap: wrap;
gap: 14px;
margin-top: 28px;
}

.button,
.secondary-button {
display: inline-block;
padding: 12px 20px;
border-radius: 8px;
font-weight: 700;
text-decoration: none;
}

.button {
background: var(--accent);
color: #08131a;
}

.button:hover {
background: #8af2d2;
transform: translateY(-2px);
}

.secondary-button {
border: 1px solid var(--border);
color: var(--text);
}

.secondary-button:hover {
border-color: var(--accent);
}

.note {
margin-top: 25px;
color: var(--muted);
font-size: 0.88rem;
}

.section {
padding: 75px 8%;
}

.section-intro {
max-width: 650px;
}

.cards {
display: grid;
grid-template-columns: repeat(3, minmax(0, 1fr));
gap: 20px;
margin-top: 35px;
}

.card {
padding: 26px;
background: var(--panel);
border: 1px solid var(--border);
border-radius: 14px;
}

.card:hover {
border-color: var(--accent);
}

.number {
color: var(--accent);
font-weight: 700;
}

.card h3 {
font-size: 1.25rem;
}

.about {
background: #10182b;
}

.about > p:not(.eyebrow) {
max-width: 750px;
}

.about li {
margin: 10px 0;
}

.contact {
text-align: center;
}

.contact > p:not(.eyebrow) {
max-width: 650px;
margin: 15px auto;
}

.contact .note {
font-size: 0.82rem;
}

footer {
padding: 25px 8%;
border-top: 1px solid var(--border);
color: var(--muted);
font-size: 0.88rem;
}

footer a {
color: var(--muted);
}

@media (max-width: 760px) {
.header {
align-items: flex-start;
flex-direction: column;
}

.cards {
grid-template-columns: 1fr;
}

.hero {
padding-top: 65px;
}

.section {
padding-top: 55px;
padding-bottom: 55px;
}
}
